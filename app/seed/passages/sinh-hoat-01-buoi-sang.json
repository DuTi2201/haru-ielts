      "title_vi": "Sáng thứ Hai",
      "scene_vi": "Sáng thứ Hai ở văn phòng. Hai đồng nghiệp là 수진 và 민수 gặp nhau ở cửa.",
      "speakers": {
        "F": "수진",
        "M": "민수"
