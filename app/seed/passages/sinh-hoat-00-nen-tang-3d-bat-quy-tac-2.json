      "lines": [
        {
          "who": "F",
          "ko": "안녕하십니까? 투안 씨는 어디에 삽니까?",
          "vi": "Xin chào. Anh Tuấn sống ở đâu?"
        },
        {
          "who": "M",
          "ko": "저는 서울에 삽니다. 한국어를 공부합니다.",
          "vi": "Tôi sống ở Seoul. Tôi học tiếng Hàn."
        },
        {
          "who": "F",
          "ko": "한국어 공부가 어렵지 않습니까?",
          "vi": "Học tiếng Hàn không khó sao?"
        },
        {
          "who": "M",
          "ko": "네, 어렵습니다. 그래도 매일 한국 노래를 듣습니다.",
          "vi": "Vâng, khó. Dù vậy ngày nào tôi cũng nghe nhạc Hàn."
        },
        {
          "who": "F",
          "ko": "한국 음식은 어떻습니까?",
          "vi": "Món ăn Hàn Quốc thì sao?"
        },
        {
          "who": "M",
          "ko": "맛있습니다. 하지만 매운 음식은 먹지 못합니다.",
          "vi": "Ngon. Nhưng món cay thì tôi không ăn được."
        },
        {
          "who": "F",
          "ko": "그렇습니까? 한국 친구는 많습니까?",
          "vi": "Vậy sao? Anh có nhiều bạn Hàn không?"
        },
        {
          "who": "M",
          "ko": "네, 많습니다. 친구들이 저를 많이 돕습니다.",
          "vi": "Vâng, nhiều. Các bạn giúp tôi rất nhiều."
        },
        {
          "who": "F",
          "ko": "알겠습니다. 감사합니다.",
          "vi": "Tôi hiểu rồi. Xin cảm ơn."
