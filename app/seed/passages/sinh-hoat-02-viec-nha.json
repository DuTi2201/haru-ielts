      "lines": [
        {
          "who": "N",
          "ko": "주말 아침에 저는 집안일을 해요.",
          "vi": "Sáng cuối tuần tôi làm việc nhà."
        },
        {
          "who": "N",
          "ko": "먼저 창문을 열고 청소를 해요.",
          "vi": "Trước hết tôi mở cửa sổ rồi dọn dẹp."
        },
        {
          "who": "N",
          "ko": "방이 지저분하면 공부를 할 수 없어요.",
          "vi": "Phòng mà bừa bộn thì tôi không học được."
        },
        {
          "who": "N",
          "ko": "그래서 청소기를 돌리고 바닥을 닦아요.",
          "vi": "Vì vậy tôi hút bụi rồi lau sàn."
        },
        {
          "who": "N",
          "ko": "빨래는 세탁기에 넣어 놓고 설거지를 해요.",
          "vi": "Quần áo thì tôi bỏ sẵn vào máy giặt rồi đi rửa bát."
        },
        {
          "who": "N",
          "ko": "어제는 청소를 하느라고 아침을 못 먹었어요.",
          "vi": "Hôm qua vì mải dọn dẹp nên tôi chưa ăn sáng được."
        },
        {
          "who": "N",
          "ko": "오늘부터 쓰레기는 매일 아침에 버리기로 했어요.",
          "vi": "Từ hôm nay tôi quyết định sẽ đổ rác vào mỗi buổi sáng."
        },
        {
          "who": "N",
          "ko": "집이 깨끗하면 마음도 편해요.",
          "vi": "Nhà sạch sẽ thì lòng cũng thấy thoải mái."
        }
      ],
