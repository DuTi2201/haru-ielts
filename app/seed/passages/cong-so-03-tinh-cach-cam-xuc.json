    {
      "id": "cong-so-03-r1",
      "kind": "reading",
      "title_ko": "나의 성격",
      "title_vi": "Tính cách của tôi",
      "lines": [
        {
          "who": "N",
          "ko": "저는 성격이 내성적이고 꼼꼼한 편이에요.",
          "vi": "Tôi thuộc kiểu hướng nội và tỉ mỉ."
        },
        {
          "who": "N",
          "ko": "발표를 할 때마다 실수할까 봐 걱정이 돼요.",
          "vi": "Mỗi lần thuyết trình tôi đều lo sẽ mắc lỗi."
        },
        {
          "who": "N",
          "ko": "그래서 자료를 여러 번 확인하다가 마감 시간을 놓칠 뻔한 적도 있어요.",
          "vi": "Vì vậy có lần tôi kiểm tra tài liệu nhiều lần đến mức suýt lỡ hạn chót."
        },
        {
          "who": "N",
          "ko": "긴장해도 겉으로는 괜찮은 척하는 습관이 있어요.",
          "vi": "Dù căng thẳng tôi vẫn có thói quen làm ra vẻ bình thường bên ngoài."
        },
        {
          "who": "N",
          "ko": "하지만 요즘은 힘들 때 친구에게 솔직하게 말해 버려요.",
          "vi": "Nhưng dạo này khi mệt tôi nói thẳng với bạn luôn."
        },
        {
          "who": "N",
          "ko": "그러면 마음이 한결 편해져요.",
          "vi": "Làm vậy tâm trạng nhẹ nhõm hẳn."
        }
      ],
