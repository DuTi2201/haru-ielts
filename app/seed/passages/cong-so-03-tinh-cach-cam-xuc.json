      "kind": "dialogue",
      "title_ko": "면접 전날",
      "title_vi": "Hôm trước buổi phỏng vấn",
      "scene_vi": "Hai người bạn nói chuyện qua điện thoại tối trước ngày phỏng vấn.",
      "speakers": {
        "F": "지수",
        "M": "현우"
      },
      "lines": [
        {
          "who": "F",
          "ko": "현우 씨, 내일 면접이죠? 준비는 잘돼요?",
          "vi": "Hyunwoo, mai phỏng vấn đúng không? Chuẩn bị ổn chứ?"
        },
        {
          "who": "M",
          "ko": "네, 그런데 실수할까 봐 너무 불안해요.",
          "vi": "Vâng, nhưng em sợ mắc lỗi nên lo lắm."
        },
        {
          "who": "F",
          "ko": "저도 작년에 면접 보기 전에 긴장해서 잠을 못 잤어요.",
          "vi": "Năm ngoái trước khi phỏng vấn tôi cũng căng thẳng đến mức không ngủ được."
        },
        {
          "who": "M",
          "ko": "그래서 면접은 잘 보셨어요?",
          "vi": "Vậy chị phỏng vấn tốt chứ?"
        },
        {
          "who": "F",
          "ko": "처음에는 대답을 못 해서 울 뻔했는데 천천히 말했더니 괜찮았어요.",
          "vi": "Lúc đầu không trả lời được nên chút nữa thì khóc, nhưng nói chậm lại thì ổn."
        },
        {
          "who": "M",
          "ko": "저는 모르는 질문을 받으면 당황해서 아는 척하고 말 것 같아요.",
          "vi": "Em mà gặp câu hỏi không biết, chắc sẽ hoảng rồi làm ra vẻ biết mất."
        },
        {
          "who": "F",
          "ko": "모르면 솔직하게 말하는 게 더 좋아요.",
          "vi": "Không biết thì cứ nói thật sẽ tốt hơn."
        },
        {
          "who": "M",
          "ko": "알겠어요. 내일은 침착하게 대답해 볼게요.",
          "vi": "Em hiểu rồi. Mai em sẽ thử trả lời thật điềm tĩnh."
        }
      ],
