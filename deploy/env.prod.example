# Copy this file to  .env.prod  in the repo root (it is git-ignored) and fill it in.
#   cp deploy/env.prod.example .env.prod
# It stays on YOUR machine; haru-gcp.sh sends it to the VM over ssh (mode 600).
# Fastest way to fill it: Railway > project Haru > api service > Variables > Raw Editor > copy all,
# paste below, then delete the lines named in "DO NOT PASTE". Nothing is printed or logged by the scripts.
#
# Format: KEY=value, one per line, no spaces around "=". Values with $ or spaces: wrap in 'single quotes'.

# ---- required -----------------------------------------------------------------------------------
# Use the SAME JWT_SECRET as before so logged-in sessions survive the move (a new one just logs everybody out).
JWT_SECRET=
GEMINI_API_KEY=
# Chirp 3 HD voice key (empty = Gemini TTS only). Railway names it TTS_GG_Chirp.
TTS_GG_Chirp=

# The private bucket: audio, pictures AND the nightly database backup this deploy restores from.
AUDIO_STORAGE=gcs
AUDIO_GCS_BUCKET=
# The service-account key: the WHOLE JSON on ONE line inside single quotes, like
#   AUDIO_GCS_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
# (keep the \n sequences as they are; do not turn them into real line breaks)
AUDIO_GCS_CREDENTIALS=
# Lectures are played from a time-limited signed link into the bucket instead of through the API (the
# API checks that the bucket accepts the link and serves the file itself if not). On by default;
# uncomment to switch it off.
# AUDIO_REDIRECT_TO_GCS=false

# Who may call the API from a browser: your published Lovable domain (and previews through the regex).
CORS_ORIGINS=https://haru-kr.lovable.app
CORS_ORIGIN_REGEX=^https://.*\.lovable\.app$

ENVIRONMENT=production

# ---- Thu phí (payOS) ----------------------------------------------------------------------------
# Off until you set BILLING_ENABLED=true. The three PAYOS_* values are SECRETS: copy them from
# my.payos.vn (Kênh thanh toán -> Thông tin tích hợp) into THIS file only (Mac + VM), never into
# chat, code, GitHub, Lovable or Railway. Webhook URL to register in payOS:
#   https://<your API domain>/api/v1/billing/payos/webhook
# BILLING_ENABLED=true
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# Where payOS sends the buyer back to (no trailing slash):
# FRONTEND_URL=https://haru-kr.lovable.app
# Not secrets: the support link and who sells (shown on /terms, /refund, /contact):
# BILLING_SUPPORT_URL=https://zalo.me/...
# MERCHANT_NAME=
# MERCHANT_TAX_ID=
# MERCHANT_ADDRESS=
# MERCHANT_EMAIL=
# MERCHANT_PHONE=
# The corpus / editorials / real past papers are open to learners; to close them to the team only:
# BILLING_PRIVATE_SOURCES=true

# ---- optional: anything else you had set on Railway (model names, Chirp voices, limits, payOS...) -
# GEMINI_MODEL_PODCAST=
# TTS_CHIRP_VOICE=ko-KR-Chirp3-HD-Iapetus
# MAX_INGEST_FILE_MB=20

# ---- DO NOT PASTE (the VM sets them itself; if pasted they are ignored) ---------------------------
# DATABASE_URL, REDIS_URL, PORT, and every RAILWAY_* variable.

# Azure Neural TTS for short Korean texts (letters, words, sentences). Empty = Google Chirp.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_TTS_VOICE=ko-KR-SunHiNeural
# AZURE_TTS_VOICE_MALE=ko-KR-InJoonNeural
# AZURE_TTS_RATE=0.95
